{
  "name": "is-notification-service",
  "version": "1.0.0",
  "description": "Email notification microservice",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server.js 3002",
    "format": "biome check --write .",
    "quality": "biome check --changed --since=main",
    "test": "vitest run --coverage --reporter=tree"
  },
  "overrides": {
    "axios": "1.13.6"
  },
  "dependencies": {
    "axios": "1.13.6",
    "body-parser": "2.2.2",
    "dotenv": "^17.4.2",
    "express": "^4.20.0",
    "notifications-node-client": "^8.3.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "6.3.3",
    "vitest": "^4.1.5"
  }
}
